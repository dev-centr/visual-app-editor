{
  "name": "visual-app-editor",
  "displayName": "Visual App Editor",
  "description": "Visual editing of Flutter (.dart) and React / React Native (.tsx/.jsx) UI source through the Visual App Editor service.",
  "version": "0.1.0",
  "publisher": "devcentr",
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "repository": { "type": "git", "url": "https://github.com/dev-centr/visual-app-editor.git", "directory": "plugins/vscode" },
  "homepage": "https://docs.devcentr.org/visual-app-editor/",
  "bugs": { "url": "https://github.com/dev-centr/visual-app-editor/issues" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["flutter", "react", "react native", "ui", "visual editor"],
  "packageManager": "pnpm@10.33.0",
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:dart", "onLanguage:typescriptreact", "onLanguage:javascriptreact"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "visualAppEditor", "title": "Visual App Editor", "icon": "media/activity.svg" }]
    },
    "views": {
      "visualAppEditor": [
        { "id": "visualAppEditor.tree", "name": "Widget Tree" },
        { "id": "visualAppEditor.inspector", "name": "Inspector", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "visualAppEditor.refresh", "title": "Refresh", "category": "Visual App Editor", "icon": "$(refresh)" },
      { "command": "visualAppEditor.restartService", "title": "Restart Service", "category": "Visual App Editor" },
      { "command": "visualAppEditor.moveUp", "title": "Move Up", "category": "Visual App Editor", "icon": "$(arrow-up)" },
      { "command": "visualAppEditor.moveDown", "title": "Move Down", "category": "Visual App Editor", "icon": "$(arrow-down)" },
      { "command": "visualAppEditor.wrap", "title": "Wrap With…", "category": "Visual App Editor", "icon": "$(symbol-namespace)" },
      { "command": "visualAppEditor.delete", "title": "Delete Widget", "category": "Visual App Editor", "icon": "$(trash)" },
      { "command": "visualAppEditor.reveal", "title": "Reveal in Editor", "category": "Visual App Editor" },
      { "command": "visualAppEditor.selectPage", "title": "Select Page", "category": "Visual App Editor", "icon": "$(list-selection)" }
    ],
    "menus": {
      "view/title": [
        { "command": "visualAppEditor.refresh", "when": "view == visualAppEditor.tree", "group": "navigation@1" },
        { "command": "visualAppEditor.selectPage", "when": "view == visualAppEditor.tree", "group": "navigation@0" }
      ],
      "view/item/context": [
        { "command": "visualAppEditor.moveUp", "when": "view == visualAppEditor.tree && viewItem == child", "group": "inline@1" },
        { "command": "visualAppEditor.moveDown", "when": "view == visualAppEditor.tree && viewItem == child", "group": "inline@2" },
        { "command": "visualAppEditor.wrap", "when": "view == visualAppEditor.tree", "group": "inline@3" },
        { "command": "visualAppEditor.delete", "when": "view == visualAppEditor.tree && viewItem == child", "group": "inline@4" }
      ]
    },
    "configuration": {
      "title": "Visual App Editor",
      "properties": {
        "visualAppEditor.serviceCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that starts the service: a compiled `vae_service` executable or `dart run <repo>/packages/service/bin/vae_service.dart`. Empty: `$VAE_SERVICE`, then `vae_service` on PATH, then `packages/service` inside the workspace."
        },
        "visualAppEditor.reactAdapterCommand": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional command for the React adapter, e.g. `node <repo>/adapters/react/dist/cli.js`. Enables `.tsx`/`.jsx` files."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:integration": "node esbuild.mjs && tsc -p tsconfig.test.json && node out-test/test/integration/runTest.js",
    "test": "pnpm typecheck && pnpm test:unit",
    "package": "node esbuild.mjs --production && node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
