{
  "name": "@devcentr/vae-react-adapter",
  "version": "0.1.0",
  "description": "Visual App Editor language adapter for React and React Native (TypeScript compiler API).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": { "vae-react-adapter": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "toolkits"],
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": { "typescript": "~5.9.3" },
  "devDependencies": { "@types/node": "^22.20.5", "vitest": "^5.0.4" }
}
